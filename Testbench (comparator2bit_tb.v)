`timescale 1ns/1ps

module comparator2bit_tb;

reg [1:0] A, B;
wire A_greater, A_equal, A_less;

comparator2bit uut (
    .A(A),
    .B(B),
    .A_greater(A_greater),
    .A_equal(A_equal),
    .A_less(A_less)
);

initial begin
    $display("Time\tA\tB\tA>B\tA=B\tA<B");
    $monitor("%0t\t%d\t%d\t%b\t%b\t%b",
             $time, A, B, A_greater, A_equal, A_less);

    A = 2'b00; B = 2'b00; #10;
    A = 2'b01; B = 2'b10; #10;
    A = 2'b11; B = 2'b01; #10;
    A = 2'b10; B = 2'b10; #10;
    A = 2'b01; B = 2'b00; #10;

    $finish;
end

endmodule